# Шаблон переменных окружения.
# Скопируйте файл в .env и заполните значения.
# .env исключён из Git (.gitignore), .env.example — нет.
#
# Плагин .opencode/plugins/confluence читает .env при каждом вызове инструмента,
# поэтому перезапуск OpenCode после изменения значений не требуется.

# Базовый адрес Confluence без завершающего слеша.
CONFLUENCE_URL=https://your-domain.atlassian.net

# Email пользователя для Basic Auth.
CONFLUENCE_EMAIL=you@example.com

# API token пользователя. Значение хранится только в .env.
CONFLUENCE_API_TOKEN=YOU_CONFLUENCE_API_TOKEN
